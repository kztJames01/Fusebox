{
  "name": "fusebox",
  "version": "0.1.0",
  "description": "Agent execution gateway with receipts — supervised process execution, MCP stdio proxy, intent contracts and hash-chained audit ledger",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "fusebox": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "schemas/**/*.json",
    "fixtures/**/*.json",
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    "rust/src/**/*.rs"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rust:build": "cargo build --release --manifest-path rust/Cargo.toml",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml",
    "release:check": "node -e \"const p=require('./package.json');const required=['name','version','description','license','main','bin'];const missing=required.filter(k=>!p[k]);if(missing.length){console.error('release:check FAILED — missing fields: '+missing.join(', '));process.exit(1);}console.log('release:check passed');\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "agent-gateway",
    "execution-supervisor",
    "receipt-ledger",
    "intent-contract",
    "cli",
    "ai-coding",
    "process-confinement",
    "fusebox"
  ],
  "dependencies": {
    "@babel/parser": "^7.26.5",
    "@babel/types": "^7.26.5",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "ignore": "^5.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@babel/core": "^7.26.5",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "resolutions": {
    "@babel/parser": "^7.26.5"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kztJames01/Fusebox.git"
  },
  "homepage": "https://github.com/kztJames01/Fusebox#readme",
  "bugs": {
    "url": "https://github.com/kztJames01/Fusebox/issues"
  },
  "author": "kaungzawthant"
}
